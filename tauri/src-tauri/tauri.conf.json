{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Goal",
  "version": "2.0.0",
  "identifier": "com.shuraproger.gamegoal",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "widget",
        "url": "widget.html",
        "title": "Game Goal",
        "width": 412,
        "height": 208,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "ShuraProger",
    "shortDescription": "Виджет прогресса заработка на игру",
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Russian"], "installerHooks": "windows/hooks.nsh" }
    }
  }
}
